{
  "name": "giftblog",
  "version": "0.1.0",
  "private": true,
  "description": "Gift-guide blog platform (Phase 1: code / structure / SEO / admin). Phase 2: AI Content Engine.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "deploy:cloudflare-social": "opennextjs-cloudflare build && wrangler deploy --config wrangler-social.jsonc",
    "seed:build": "node scripts/build-seed.mjs",
    "seed:local": "node scripts/build-seed.mjs && node scripts/reset-local.mjs",
    "seed:supabase": "node scripts/seed-supabase.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@google/genai": "^2.27.0",
    "@next/third-parties": "^16.4.1",
    "@supabase/supabase-js": "^2.49.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.0",
    "wrangler": "^4.151.1"
  }
}
