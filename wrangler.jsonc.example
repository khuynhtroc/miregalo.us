{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miregalo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.miregalo.us",
    "DB_DRIVER": "supabase"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "routes": [
    { "pattern": "miregalo.us/*", "zone_name": "miregalo.us" },
    { "pattern": "www.miregalo.us/*", "zone_name": "miregalo.us" }
  ]
}
