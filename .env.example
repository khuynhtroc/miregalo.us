# ─────────────────────────────────────────────────────────────
#  Site
# ─────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for canonical, sitemap, schema.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
#  Database driver
#   local    -> data/db.json (zero setup, good for dev)
#   supabase -> Supabase Postgres (run supabase/migrations/*.sql first)
# ─────────────────────────────────────────────────────────────
DB_DRIVER=local

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is only used on the server (admin writes + seed script). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
#  Admin (/admin)
# ─────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ─────────────────────────────────────────────────────────────
#  Google Search Console (optional) - service account with access to the property
# ─────────────────────────────────────────────────────────────
GSC_CLIENT_EMAIL=
# Paste the private key with literal \n line breaks
GSC_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────
#  Phase 2 - AI Content Engine (not used yet)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
